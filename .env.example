# TiDB connection (MySQL 8.0 wire-compatible). TiDB Cloud *requires* TLS.
TIDB_HOST=127.0.0.1
TIDB_PORT=4000
TIDB_USER=root
TIDB_PASSWORD=
TIDB_DATABASE=cement_desk
TIDB_TLS=false
DB_POOL_SIZE=10

# Auth
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-at-least-32-bytes-long-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=5184000
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3

# Server
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Ops
TOMBSTONE_RETENTION_DAYS=180
ENABLE_JOBS=false
# SMTP_URL=smtp://user:pass@host:587
# MAIL_FROM=Cement Desk <no-reply@example.com>
# DEV_MAIL_LOG=true   # when SMTP_URL absent, tokens are logged (dev only, never enable in prod)
