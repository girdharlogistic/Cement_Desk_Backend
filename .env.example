# ---- database ----
# SQLite, on this box. Replaced TiDB Cloud Serverless on 2026-09-05: the free
# tier's limits had become the binding constraint. The directory is created at
# boot; the -wal and -shm files live beside the database.
SQLITE_PATH=/home/ubuntu/cementdesk-data/cementdesk.db

# Nightly `VACUUM INTO` snapshots. Nothing replicates the file any more, so
# this is the only copy that survives the disk. Empty disables them.
SQLITE_BACKUP_DIR=/home/ubuntu/cementdesk-backups
SQLITE_BACKUP_KEEP=14

# The old TiDB credentials. The server no longer reads these — only
# scripts/migrate_tidb_to_sqlite.ts does, and only to re-run the one-off copy.
TIDB_HOST=127.0.0.1
TIDB_PORT=4000
TIDB_USER=root
TIDB_PASSWORD=
TIDB_DATABASE=cement_desk
TIDB_TLS=false

# Auth
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-at-least-32-bytes-long-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=5184000
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3

# Server
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Ops
TOMBSTONE_RETENTION_DAYS=180
ENABLE_JOBS=false
# Mail: Brevo first (own domain, free plan = 300/day), SMTP as backup once the
# day's BREVO_DAILY_LIMIT is used or Brevo refuses. Brevo is never used under tests.
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER_EMAIL=noreply@girdharlogistics.in
# BREVO_SENDER_NAME=Cement Desk
# BREVO_DAILY_LIMIT=290
# SMTP_URL=smtp://user:pass@host:587
# MAIL_FROM=Cement Desk <no-reply@example.com>
# DEV_MAIL_LOG=true   # when SMTP_URL absent, tokens are logged (dev only, never enable in prod)

# Notification console (/console) — leave CONSOLE_PASSWORD_HASH empty to keep
# the route switched off (it 404s, as if it were not there).
# Its own login on purpose: the page can push to every install, which no firm
# role should ever be able to grow into. Hash a password with:
#   node -e "require('@node-rs/argon2').hash(process.argv[1],{memoryCost:65536,timeCost:3,parallelism:1}).then(console.log)" 'your-password'
# CONSOLE_EMAIL=you@example.com
# CONSOLE_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=1$...
# CONSOLE_SESSION_TTL_SECONDS=28800
# Firebase service-account JSON. Never inside this repo — it can notify everyone.
# FCM_KEY_PATH=/home/ubuntu/.secrets/cement-desk-fcm.json
# FCM_TOPIC=all
#
# Web push — the browser half of the same Firebase project. The web app is a
# separate registration from the Android one and has its own app id; get both
# from Firebase console -> Project settings -> Your apps -> Web, or create one
# through the Management API. None of this is secret: Firebase web config
# ships inside every page that uses it. Leave FCM_WEB_APP_ID empty and web
# push is simply off — /app/push-config answers null and the PWA says so.
# FCM_WEB_APP_ID=1:000000000000:web:0000000000000000000000
# FCM_WEB_API_KEY=AIza...
# FCM_VAPID_KEY=            # optional; empty uses the Firebase SDK's own key
# FCM_WEB_PROJECT_ID=cement-desk
# FCM_WEB_SENDER_ID=1055000759045
# FCM_WEB_AUTH_DOMAIN=cement-desk.firebaseapp.com
# Where uploaded notification images are written, and the public origin they
# are served from. Google fetches the image itself, so a localhost origin gives
# a notification with a silently missing picture.
# CONSOLE_MEDIA_DIR=/home/ubuntu/cementdesk-media
# PUBLIC_BASE_URL=https://cementdesk.example.com
