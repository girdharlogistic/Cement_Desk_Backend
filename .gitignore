node_modules/
dist/
# Every .env variant, not just `.env` — a plain `.env` rule left backup copies
# like `.env.bak.1786709454` (a verbatim copy, TiDB and mail credentials and
# all) one `git add .` away from a public repo. The example file carries no
# secrets and stays tracked.
.env*
!.env.example
*.log
coverage/

# Google service-account keys. Same reasoning as .env*: one `git add .` away
# from publishing a credential that can push an app update to every user.
*service-account*.json
*-sa.json
