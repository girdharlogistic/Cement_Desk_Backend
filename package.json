{
  "name": "cement-desk-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Cement Desk backend API (SQLite) \u2014 auth, tenancy, masters, freight, stock, landing, sync, import/export",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "backup": "tsx -e \"import('./src/jobs/backup').then(m => console.log(m.backupNow()))\""
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@types/nodemailer": "^8.0.1",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "nodemailer": "^9.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "mysql2": "^3.11.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
